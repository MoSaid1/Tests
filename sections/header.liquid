{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}
{%- if settings.predictive_search_enabled -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'wazen-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wazen-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign wish_count_default = 0
-%}

<div class="header-wrapper wz-header-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="wz-announce">
    <div class="wz-container wz-announce__row">
      <div class="wz-announce__msg">
        <span class="wz-announce__dot"></span>
        <span>
          {%- if section.settings.announcement_text != blank -%}
            {{ section.settings.announcement_text }}
          {%- else -%}
            {{ 'wazen.announcement.default' | t }}
          {%- endif -%}
        </span>
      </div>
      <div class="wz-announce__right">
        {%- if section.settings.support_phone != blank -%}
          <span class="wz-announce__phone">{{ 'wazen.announcement.support' | t }} {{ section.settings.support_phone }}</span>
        {%- endif -%}
        {%- if localization.available_languages.size > 1 -%}
          <localization-form class="wz-lang-switch" data-prevent-hide>
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="wz-sticky">
    <div class="wz-header-slot">
      <div class="wz-header-capsule">
        <div class="wz-header-row">
          <div class="wz-header-brand">
            <button type="button" class="wz-icon-btn wz-hide-desktop" id="wz-nav-open" aria-label="{{ 'wazen.nav.menu' | t }}" aria-controls="wz-mobile-drawer" aria-expanded="false">
              {%- render 'wazen-icon', icon: 'menu' -%}
            </button>
            <a href="{{ routes.root_url }}" class="wz-logo-link">
              {%- if settings.logo != blank -%}
                {{ settings.logo | image_url: width: 300 | image_tag: class: 'wz-logo-img', alt: shop.name, widths: '130,180,260', height: 34 }}
              {%- else -%}
                {{ 'wazen-logo.svg' | inline_asset_content }}
              {%- endif -%}
            </a>
          </div>

          <button type="button" class="wz-search-trigger" id="wz-search-open" aria-haspopup="dialog">
            {%- render 'wazen-icon', icon: 'search' -%}
            <span class="wz-search-trigger__text">{{ 'wazen.header.search_placeholder' | t }}</span>
            <span class="wz-search-trigger__key">/</span>
          </button>

          <div class="wz-header-icons">
            <a href="{{ pages.wishlist.url | default: '/pages/wishlist' }}" class="wz-icon-stack" id="wz-wishlist-link">
              {%- render 'wazen-icon', icon: 'heart' -%}
              <span class="wz-icon-stack__label">{{ 'wazen.nav.wishlist' | t }}</span>
              <span class="wz-icon-stack__badge" id="wz-wishlist-count" hidden>0</span>
            </a>
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="wz-icon-stack">
              {%- render 'wazen-icon', icon: 'account' -%}
              <span class="wz-icon-stack__label">{{ 'wazen.nav.account' | t }}</span>
            </a>
            <a href="{{ routes.cart_url }}" class="wz-cart-btn" id="cart-icon-bubble">
              {%- render 'wazen-icon', icon: 'cart' -%}
              <span class="wz-cart-btn__count">{{ cart.item_count }}</span>
            </a>
          </div>
        </div>

        <nav class="wz-navrow wz-hide-mobile" id="wz-desktop-nav">
          <ul class="wz-navrow__list">
            {%- for link in section.settings.menu.links -%}
              <li
                class="wz-navrow__item{% if link.links.size > 0 %} has-mega{% endif %}"
                {% if link.links.size > 0 %}data-mega="mega-{{ forloop.index }}"{% endif %}
              >
                <a href="{{ link.url }}" class="wz-navrow__link">
                  {{ link.title }}
                  {%- if link.links.size > 0 -%}{%- render 'wazen-icon', icon: 'chevron-down' -%}{%- endif -%}
                </a>
              </li>
            {%- else -%}
              <li class="wz-navrow__item"><a href="{{ routes.root_url }}" class="wz-navrow__link">{{ 'wazen.nav.home' | t }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>

        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="wz-megapanel wz-hide-mobile" data-mega-panel="mega-{{ forloop.index }}">
              <div class="wz-megapanel__grid">
                {%- assign col_count = 0 -%}
                {%- for grandchild in link.links -%}
                  {%- if grandchild.links.size > 0 -%}
                    {%- assign col_count = col_count | plus: 1 -%}
                    <div class="wz-megapanel__col">
                      <div class="wz-megapanel__heading">{{ grandchild.title }}</div>
                      <div class="wz-megapanel__links">
                        {%- for leaf in grandchild.links -%}
                          <a href="{{ leaf.url }}">{{ leaf.title }}</a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
                {%- if col_count == 0 -%}
                  <div class="wz-megapanel__col">
                    <div class="wz-megapanel__heading">{{ link.title }}</div>
                    <div class="wz-megapanel__links">
                      {%- for leaf in link.links -%}
                        <a href="{{ leaf.url }}">{{ leaf.title }}</a>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
                {%- if section.settings.mega_promo_heading != blank -%}
                  <div class="wz-megapanel__promo">
                    <div class="wz-megapanel__promo-kicker">{{ 'wazen.header.featured' | t }}</div>
                    <div class="wz-megapanel__promo-title">{{ section.settings.mega_promo_heading }}</div>
                    <div class="wz-megapanel__promo-media">
                      {%- if section.settings.mega_promo_image != blank -%}
                        {{ section.settings.mega_promo_image | image_url: width: 400 | image_tag: alt: section.settings.mega_promo_heading }}
                      {%- else -%}
                        <span>{{ 'wazen.media.campaign_image' | t }}</span>
                      {%- endif -%}
                    </div>
                    <a href="{{ section.settings.mega_promo_link }}" class="wz-megapanel__promo-cta">
                      {{ 'wazen.header.shop_offer' | t }}
                      {%- render 'wazen-icon', icon: 'arrow-end' -%}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- render 'wazen-search-modal' -%}
{%- render 'wazen-mobile-drawer', menu: section.settings.menu -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "richtext",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "<p>Free shipping on orders above 15,000 EGP across Cairo & Alexandria</p>"
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Support phone number",
      "default": "16123"
    },
    {
      "type": "header",
      "content": "Mega menu promo tile"
    },
    {
      "type": "text",
      "id": "mega_promo_heading",
      "label": "Promo heading",
      "default": "Inverter refrigerators up to 22% off"
    },
    {
      "type": "image_picker",
      "id": "mega_promo_image",
      "label": "Promo image"
    },
    {
      "type": "url",
      "id": "mega_promo_link",
      "label": "Promo link"
    }
  ]
}
{% endschema %}
