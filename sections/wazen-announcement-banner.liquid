{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<div class="wz-section">
  <div class="wz-announce">
    <span class="wz-announce__icon">{%- render 'wazen-icon', icon: section.settings.icon, size: 18 -%}</span>
    <span>{{ section.settings.text }}</span>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="wz-btn wz-btn--primary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wazen announcement banner",
  "settings": [
    {
      "type": "select", "id": "icon", "label": "Icon", "default": "truck",
      "options": [
        { "value": "truck", "label": "Delivery" },
        { "value": "shield", "label": "Shield" },
        { "value": "star", "label": "Star" },
        { "value": "check", "label": "Check" }
      ]
    },
    { "type": "text", "id": "text", "label": "Text", "default": "Free delivery on orders above 15,000 EGP, this week only." },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Wazen announcement banner" }]
}
{% endschema %}
