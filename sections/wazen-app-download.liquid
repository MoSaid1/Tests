{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<div class="wz-section">
  <div class="wz-app">
    <div>
      <h2 class="wz-app__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="wz-app__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="wz-app__badges">
        {%- if section.settings.app_store_link != blank -%}
          <a href="{{ section.settings.app_store_link }}" class="wz-app__badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 12.6c0-2 1.6-3 1.7-3.1-1-1.4-2.4-1.6-2.9-1.6-1.2-.1-2.4.7-3 .7-.6 0-1.6-.7-2.6-.7-1.3 0-2.6.8-3.3 2-1.4 2.4-.4 6 1 8 .7 1 1.5 2.1 2.6 2 1-.1 1.4-.6 2.6-.6s1.6.6 2.6.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3-.1 0-2.2-.9-2.3-3zM14.5 5.8c.5-.7.9-1.6.8-2.6-.8 0-1.8.5-2.4 1.2-.5.6-1 1.6-.9 2.5.9.1 1.9-.5 2.5-1.1z"/></svg>
            <span>{{ section.settings.app_store_label }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.play_store_link != blank -%}
          <a href="{{ section.settings.play_store_link }}" class="wz-app__badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 3.5c-.3.2-.5.6-.5 1v15c0 .4.2.8.5 1l8.7-8.5-8.7-8.5zm10 8.5l2.3-2.3 3-1.7c.6-.3.6-1.1 0-1.4l-3-1.7-2.3 2.3v4.8zm0 1.4v4.8l2.3 2.3 3-1.7c.6-.3.6-1.1 0-1.4l-3-1.7-2.3-2.3zM5.5 20.6l8-7.9-8-7.9c-.1.1-.1.2-.1.3v15.2c0 .1 0 .2.1.3z"/></svg>
            <span>{{ section.settings.play_store_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="wz-app__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <div class="wz-placeholder-media" style="width:100%;height:100%;">{{ 'wazen.media.image' | t }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wazen app download",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop faster with the Wazen app" },
    { "type": "text", "id": "text", "label": "Text", "default": "Track orders, save favorites, and get app-only deals." },
    { "type": "image_picker", "id": "image", "label": "Phone screenshot" },
    { "type": "url", "id": "app_store_link", "label": "App Store link" },
    { "type": "text", "id": "app_store_label", "label": "App Store badge label", "default": "Download on the App Store" },
    { "type": "url", "id": "play_store_link", "label": "Google Play link" },
    { "type": "text", "id": "play_store_label", "label": "Google Play badge label", "default": "Get it on Google Play" }
  ],
  "presets": [{ "name": "Wazen app download" }]
}
{% endschema %}
