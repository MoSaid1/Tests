{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="wz-section__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="wz-ba">
    <div class="wz-ba__pane">
      {%- if section.settings.before_image != blank -%}
        {{ section.settings.before_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.before_label }}
      {%- else -%}
        <div class="wz-placeholder-media" style="width:100%;height:100%;">{{ 'wazen.media.image' | t }}</div>
      {%- endif -%}
      <span class="wz-ba__tag">{{ section.settings.before_label }}</span>
    </div>
    <div class="wz-ba__pane">
      {%- if section.settings.after_image != blank -%}
        {{ section.settings.after_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.after_label }}
      {%- else -%}
        <div class="wz-placeholder-media" style="width:100%;height:100%;">{{ 'wazen.media.image' | t }}</div>
      {%- endif -%}
      <span class="wz-ba__tag">{{ section.settings.after_label }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wazen before / after",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" }
  ],
  "presets": [{ "name": "Wazen before / after" }]
}
{% endschema %}
