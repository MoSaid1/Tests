{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  <div class="wz-section__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="wz-blog-hl">
    {%- for article in section.settings.blog.articles limit: section.settings.article_limit -%}
      <a href="{{ article.url }}" class="wz-blog-hl__card">
        <div class="wz-blog-hl__media">
          {%- if article.image -%}
            {{ article.image | image_url: width: 700 | image_tag: widths: '350,500,700', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article.title }}
          {%- else -%}
            <div class="wz-placeholder-media" style="width:100%;height:100%;">{{ 'wazen.media.article_image' | t }}</div>
          {%- endif -%}
        </div>
        <div class="wz-blog-hl__date">{{ article.published_at | date: '%d %b %Y' }}</div>
        <div class="wz-blog-hl__title">{{ article.title }}</div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Wazen blog highlight",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the blog" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Buying guides and home tips." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "article_limit", "min": 2, "max": 6, "step": 1, "default": 3, "label": "Articles to show" }
  ],
  "presets": [{ "name": "Wazen blog highlight" }]
}
{% endschema %}
