{{ 'wazen-pages.css' | asset_url | stylesheet_tag }}

<div class="wz-container wz-brands-page color-{{ section.settings.color_scheme }}">
  <h1 class="wz-collection-head__title">{{ section.settings.heading }}</h1>
  <p class="wz-page-sub">{{ section.settings.subheading }}</p>

  <div class="wz-brands-page__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'brand' -%}
        <a href="{{ block.settings.link }}" class="wz-brand-page-card wz-lift" {{ block.shopify_attributes }}>
          <div class="wz-brand-page-card__name">{{ block.settings.name }}</div>
          <div class="wz-brand-page-card__count">{{ block.settings.count }}</div>
          {%- if block.settings.official -%}
            <span class="wz-badge wz-badge--soft">{{ 'wazen.brands.official' | t }}</span>
          {%- endif -%}
          <span class="wz-brand-page-card__cta">{{ 'wazen.brands.shop_all' | t }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Wazen brands directory",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Brands" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Fourteen manufacturers, every unit with local warranty and an authorised service path." }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Brand" },
        { "type": "text", "id": "count", "label": "Product count text", "default": "42 products" },
        { "type": "checkbox", "id": "official", "label": "Official partner badge", "default": true },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand", "settings": { "name": "Ariston" } }, { "type": "brand", "settings": { "name": "LG" } },
      { "type": "brand", "settings": { "name": "Midea" } }, { "type": "brand", "settings": { "name": "Haier" } },
      { "type": "brand", "settings": { "name": "Toshiba" } }, { "type": "brand", "settings": { "name": "Beko" } },
      { "type": "brand", "settings": { "name": "Fresh" } }, { "type": "brand", "settings": { "name": "Unionaire" } },
      { "type": "brand", "settings": { "name": "Sharp" } }, { "type": "brand", "settings": { "name": "Brown" } },
      { "type": "brand", "settings": { "name": "Bosch" } }, { "type": "brand", "settings": { "name": "Kenwood" } },
      { "type": "brand", "settings": { "name": "Hoover" } }, { "type": "brand", "settings": { "name": "Black+Decker" } }
    ]
  }
}
{% endschema %}
