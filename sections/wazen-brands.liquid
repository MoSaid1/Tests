{{ 'wazen-home.css' | asset_url | stylesheet_tag }}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  <div class="wz-section__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="wz-brand-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="wz-brand-tile wz-lift" {{ block.shopify_attributes }}>{{ block.settings.name }}</a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Wazen brands",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Authorised brand partner" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Fourteen manufacturers, every unit with local warranty." }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wazen brands",
      "blocks": [
        { "type": "brand", "settings": { "name": "Ariston" } },
        { "type": "brand", "settings": { "name": "LG" } },
        { "type": "brand", "settings": { "name": "Midea" } },
        { "type": "brand", "settings": { "name": "Haier" } },
        { "type": "brand", "settings": { "name": "Toshiba" } },
        { "type": "brand", "settings": { "name": "Beko" } },
        { "type": "brand", "settings": { "name": "Fresh" } },
        { "type": "brand", "settings": { "name": "Unionaire" } },
        { "type": "brand", "settings": { "name": "Sharp" } },
        { "type": "brand", "settings": { "name": "Brown" } },
        { "type": "brand", "settings": { "name": "Bosch" } },
        { "type": "brand", "settings": { "name": "Kenwood" } },
        { "type": "brand", "settings": { "name": "Hoover" } },
        { "type": "brand", "settings": { "name": "Black+Decker" } }
      ]
    }
  ]
}
{% endschema %}
