{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  {%- for block in section.blocks -%}
    <div class="wz-crow{% if block.settings.image_position == 'right' %} wz-crow--rev{% endif %}" {{ block.shopify_attributes }}>
      <div class="wz-crow__media">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1100 | image_tag: class: 'wz-crow__img', widths: '550,825,1100', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: block.settings.title }}
        {%- else -%}
          <div class="wz-crow__img wz-placeholder-media">{{ 'wazen.media.image' | t }}</div>
        {%- endif -%}
      </div>
      <div class="wz-crow__content">
        {%- if block.settings.eyebrow != blank -%}<div class="wz-crow__eyebrow">{{ block.settings.eyebrow }}</div>{%- endif -%}
        <h3 class="wz-crow__title">{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}<div class="wz-crow__text">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.button_label != blank -%}
          <a href="{{ block.settings.button_link | default: '#' }}" class="wz-btn wz-btn--outline">{{ block.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Wazen content rows",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_position", "label": "Image position (computer)", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "default": "Engineered for Egyptian homes" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Explain the story, feature, or benefit behind this section.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wazen content rows",
      "blocks": [
        { "type": "row", "settings": { "image_position": "left", "eyebrow": "Built to last", "title": "Engineered for Egyptian homes", "button_label": "Learn more" } },
        { "type": "row", "settings": { "image_position": "right", "eyebrow": "Service", "title": "Installed by our own technicians", "button_label": "Our services" } }
      ]
    }
  ]
}
{% endschema %}
