{{ 'wazen-home.css' | asset_url | stylesheet_tag }}
{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wazen-countdown.js' | asset_url }}" defer="defer"></script>

<div class="wz-section">
  <div class="wz-countban">
    {%- if section.settings.badge != blank -%}<span class="wz-countban__badge">{{ section.settings.badge }}</span>{%- endif -%}
    <h2 class="wz-countban__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="wz-countban__sub">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.deadline != blank -%}
      <div class="wz-countdown" data-countdown="{{ section.settings.deadline }}">
        <div class="wz-countdown__cell"><span data-cd="d">00</span><small>{{ 'wazen.deals.days' | t }}</small></div>
        <div class="wz-countdown__cell"><span data-cd="h">00</span><small>{{ 'wazen.deals.hours' | t }}</small></div>
        <div class="wz-countdown__cell"><span data-cd="m">00</span><small>{{ 'wazen.deals.minutes' | t }}</small></div>
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="wz-btn wz-btn--primary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wazen countdown banner",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge text", "default": "Flash sale" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Up to 30% off this weekend only" },
    { "type": "text", "id": "text", "label": "Text", "default": "Prices go back up when the timer hits zero." },
    { "type": "text", "id": "deadline", "label": "Countdown end (e.g. 2026-09-14T00:00:00)", "info": "Leave blank to hide the countdown." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Wazen countdown banner" }]
}
{% endschema %}
