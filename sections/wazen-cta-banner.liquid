{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<div class="wz-section">
  <div class="wz-ctaband">
    <h2 class="wz-ctaband__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="wz-ctaband__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="wz-btn wz-btn--primary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wazen CTA banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to upgrade your kitchen?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Browse this month's offers on top appliance brands." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop offers" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Wazen CTA banner" }]
}
{% endschema %}
