{{ 'wazen-home.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enable_marquee -%}
  <script src="{{ 'wazen-marquee.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .wz-pgrid--featured {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .wz-pgrid--featured {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }
  {%- if section.settings.enable_marquee -%}
    #shopify-section-{{ section.id }} .wz-featured-marquee__card { width: {{ section.settings.marquee_card_width }}px; }
  {%- endif -%}
{%- endstyle -%}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  <div class="wz-section__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  {%- liquid
    assign source = section.settings.collection.products | default: collections.all.products
    assign shown = 0
  -%}

  <div class="wz-pgrid wz-pgrid--featured{% if section.settings.enable_marquee %} wz-pgrid--has-marquee{% endif %}" data-scroll-grid>
    {%- for product in source limit: section.settings.product_limit -%}
      {%- render 'wazen-product-card', product: product -%}
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
    {%- if shown == 0 -%}
      {%- for i in (1..4) -%}
        <div class="wz-card wz-pcard">
          <div class="wz-pcard__media wz-placeholder-media">{{ 'wazen.media.product_image' | t }}</div>
          <div class="wz-pcard__body">
            <div class="wz-pcard__title">{{ 'onboarding.product_title' | t }}</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.enable_marquee and shown > 0 -%}
    <div class="wz-featured-marquee">
      <div class="wz-featured-marquee__track" data-marquee data-marquee-interval="{{ section.settings.marquee_speed }}">
        {%- for i in (1..2) -%}
          {%- for product in source limit: section.settings.product_limit -%}
            <div class="wz-featured-marquee__card" aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}">
              {%- render 'wazen-product-card', product: product -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Wazen featured products",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Best-selling appliances this month." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 12, "step": 1, "default": 8, "label": "Products to show" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4, "label": "Columns on computer" },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    { "type": "checkbox", "id": "enable_marquee", "label": "Move as a single row on computer", "info": "Replaces the grid with one row on computer screens where one product steps out and the next steps in every few seconds. Mobile keeps the grid above.", "default": false },
    { "type": "range", "id": "marquee_card_width", "min": 220, "max": 340, "step": 10, "default": 280, "label": "Row card width (computer)" },
    { "type": "range", "id": "marquee_speed", "min": 1.5, "max": 6, "step": 0.5, "default": 2.8, "label": "Seconds between each product change" }
  ],
  "presets": [{ "name": "Wazen featured products" }]
}
{% endschema %}
