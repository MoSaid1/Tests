{{ 'wazen-home.css' | asset_url | stylesheet_tag }}

<section class="wz-section">
  {%- if section.settings.heading != blank -%}
    <div class="wz-section__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="wz-intent-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="wz-intent-card" {{ block.shopify_attributes }} style="
        {%- if block.settings.image != blank -%}background-image:linear-gradient(180deg, rgba(16,20,24,0) 35%, rgba(16,20,24,0.75) 100%), url({{ block.settings.image | image_url: width: 700 }});
        {%- else -%}background:{{ block.settings.fallback_color }};{%- endif -%}
      ">
        <div class="wz-intent-card__kicker">{{ block.settings.kicker }}</div>
        <div class="wz-intent-card__name">{{ block.settings.title }}</div>
        <div class="wz-intent-card__desc">{{ block.settings.description }}</div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Wazen intent grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated for the season" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Four edits that change with the weather, not a database dump." }
  ],
  "blocks": [
    {
      "type": "intent",
      "name": "Edit card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "color", "id": "fallback_color", "label": "Fallback background", "default": "#0A2A47" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Beat the heat" },
        { "type": "text", "id": "title", "label": "Title", "default": "Summer Essentials" },
        { "type": "text", "id": "description", "label": "Description", "default": "Air conditioners, fans & coolers" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wazen intent grid",
      "blocks": [
        { "type": "intent", "settings": { "kicker": "Beat the heat", "title": "Summer Essentials", "description": "Air conditioners, fans & coolers" } },
        { "type": "intent", "settings": { "kicker": "Cook better", "title": "Kitchen Essentials", "description": "Cookers, air fryers, blenders" } },
        { "type": "intent", "settings": { "kicker": "Connected home", "title": "Smart Living", "description": "Smart TVs & connected appliances" } },
        { "type": "intent", "settings": { "kicker": "Spotless", "title": "Home Cleaning", "description": "Vacuum cleaners & more" } }
      ]
    }
  ]
}
{% endschema %}
