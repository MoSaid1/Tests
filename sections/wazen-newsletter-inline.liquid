{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<div class="wz-section">
  <div class="wz-newsline">
    <div class="wz-newsline__text">{{ section.settings.heading }}</div>
    {%- form 'customer', id: 'NewsletterInline', class: 'wz-newsline__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        class="wz-newsline__input"
        value="{{ form.email }}"
        placeholder="{{ 'wazen.newsletter.placeholder' | t }}"
        required
      >
      <button type="submit" class="wz-btn wz-btn--dark">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p class="wz-newsletter__msg wz-newsletter__msg--ok">{{ 'newsletter.confirmation' | t }}</p>
      {%- elsif form.errors -%}
        <p class="wz-newsletter__msg wz-newsletter__msg--err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Wazen newsletter (inline)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get offers before anyone else" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Wazen newsletter (inline)" }]
}
{% endschema %}
