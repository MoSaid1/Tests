{{ 'wazen-home.css' | asset_url | stylesheet_tag }}

<section class="wz-container wz-newsletter-wrap color-{{ section.settings.color_scheme }}">
  <div class="wz-newsletter">
    <div>
      <h2 class="wz-newsletter__title">{{ section.settings.heading }}</h2>
      <p class="wz-newsletter__sub">{{ section.settings.subheading }}</p>
    </div>
    {%- form 'customer', id: 'ContactFooter', class: 'wz-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="wz-newsletter__field-row">
        <input
          type="email"
          name="contact[email]"
          class="wz-newsletter__input"
          value="{{ form.email }}"
          placeholder="{{ 'wazen.newsletter.placeholder' | t }}"
          required
        >
        <button type="submit" class="wz-btn wz-btn--dark">{{ section.settings.button_label }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="wz-newsletter__msg wz-newsletter__msg--ok">{{ 'newsletter.confirmation' | t }}</p>
      {%- elsif form.errors -%}
        <p class="wz-newsletter__msg wz-newsletter__msg--err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Wazen newsletter",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay updated with Wazen" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Get the latest product updates, offers, and tips straight to your inbox." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Stay Updated" }
  ],
  "presets": [{ "name": "Wazen newsletter" }]
}
{% endschema %}
