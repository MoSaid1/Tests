{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="wz-section__head">
      <h2>{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="wz-social-row">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="wz-social-link" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        <span class="wz-social-link__icon">
          {%- case block.settings.platform -%}
            {%- when 'facebook' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3V5.5h-3c-2.2 0-4 1.8-4 4V12H7v3.5h3V22h3.5v-6.5H16l.5-3.5h-3V9.6c0-.3.2-.6.5-.6z"/></svg>
            {%- when 'instagram' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
            {%- when 'tiktok' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15 3c.4 2.2 1.8 3.6 4 4v3c-1.4 0-2.8-.4-4-1.2V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V3h3z"/></svg>
            {%- when 'youtube' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10.5 9.5l5 2.5-5 2.5z"/></svg>
            {%- when 'whatsapp' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm0 16.2a7.2 7.2 0 0 1-3.7-1l-.3-.2-2.7.7.7-2.6-.2-.3A7.2 7.2 0 1 1 12 19.2z"/><path d="M9.4 8.4c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.4.2.4.6 1.5.7 1.6 0 .1.1.3 0 .4-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.8 2.1 1.2 1 2 1.3 2.3 1.5.3.1.5.1.6-.1l.7-.8c.2-.3.4-.2.6-.1l1.5.7c.2.1.3.2.4.3 0 .2 0 .9-.3 1.3-.3.5-1.5 1-2.1 1-.6 0-1.3.1-4.4-1.9C8.4 14.1 6.9 11.6 6.7 11.2c-.2-.4-1-1.5-1-2.8s.7-2 .9-2.3z" fill="#fff"/></svg>
            {%- when 'twitter' -%}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4l7.3 9.7L4.4 20H7l5.6-5 4.6 6h4.4l-7.6-10 6.6-7.5h-2.6l-5 4.5L8.4 4z"/></svg>
            {%- else -%}
              {%- render 'wazen-icon', icon: 'pin', size: 20 -%}
          {%- endcase -%}
        </span>
        <span class="wz-social-link__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Wazen social links",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow Wazen" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Social link",
      "settings": [
        {
          "type": "select", "id": "platform", "label": "Platform", "default": "instagram",
          "options": [
            { "value": "facebook", "label": "Facebook" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "twitter", "label": "X / Twitter" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Instagram" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wazen social links",
      "blocks": [
        { "type": "link", "settings": { "platform": "instagram", "label": "Instagram" } },
        { "type": "link", "settings": { "platform": "facebook", "label": "Facebook" } },
        { "type": "link", "settings": { "platform": "tiktok", "label": "TikTok" } },
        { "type": "link", "settings": { "platform": "whatsapp", "label": "WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}
