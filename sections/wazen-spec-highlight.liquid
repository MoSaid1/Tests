{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  <div class="wz-spec">
    <div class="wz-spec__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <div class="wz-placeholder-media" style="width:100%;height:100%;">{{ 'wazen.media.image' | t }}</div>
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.kicker != blank -%}<div class="wz-bsplit__kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="wz-bsplit__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="wz-bsplit__text" style="max-width:none;">{{ section.settings.text }}</div>{%- endif -%}
      <div class="wz-spec__list" style="margin-top:28px;">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <div class="wz-spec__item__num">{{ block.settings.value }}</div>
            <div class="wz-spec__item__label">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wazen spec highlight",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to handle real family life" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Spec highlights that matter most, at a glance.</p>" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "500L" },
        { "type": "text", "id": "label", "label": "Label", "default": "Total capacity" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wazen spec highlight",
      "blocks": [
        { "type": "spec", "settings": { "value": "500L", "label": "Total capacity" } },
        { "type": "spec", "settings": { "value": "A+++", "label": "Energy rating" } },
        { "type": "spec", "settings": { "value": "42dB", "label": "Noise level" } },
        { "type": "spec", "settings": { "value": "10 yrs", "label": "Compressor warranty" } }
      ]
    }
  ]
}
{% endschema %}
