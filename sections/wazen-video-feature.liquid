{{ 'wazen-sections-lib.css' | asset_url | stylesheet_tag }}

<section class="wz-section color-{{ section.settings.color_scheme }}">
  <div class="wz-vfeat{% if section.settings.video_position == 'right' %} wz-vfeat--rev{% endif %}">
    <div class="wz-vfeat__media">
      {%- if section.settings.video_url != blank -%}
        {{ section.settings.video_url | external_video_tag }}
      {%- elsif section.settings.cover_image != blank -%}
        {{ section.settings.cover_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <div class="wz-placeholder-media" style="width:100%;height:100%;">{{ 'wazen.media.image' | t }}</div>
      {%- endif -%}
    </div>
    <div class="wz-vfeat__content">
      {%- if section.settings.kicker != blank -%}<div class="wz-bsplit__kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="wz-bsplit__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="wz-bsplit__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wazen video feature",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "video_url", "id": "video_url", "label": "Video (YouTube or Vimeo link)", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image (used if no video)" },
    { "type": "select", "id": "video_position", "label": "Video position (computer)", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in action" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A short paragraph about this product, service, or story.</p>" }
  ],
  "presets": [{ "name": "Wazen video feature" }]
}
{% endschema %}
